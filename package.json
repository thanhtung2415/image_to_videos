{
  "name": "image-to-videos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/backend",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:worker": "npm run dev:worker --workspace apps/backend",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "build": "npm run build --workspace apps/frontend",
    "check": "npm run check:backend && npm run build",
    "check:backend": "node scripts/check-backend.mjs",
    "backup:db": "npm run backup:db --workspace apps/backend",
    "cleanup:local": "npm run cleanup:local --workspace apps/backend",
    "seed:demo": "npm run seed:demo --workspace apps/backend",
    "start": "npm run start --workspace apps/backend"
  }
}
